# Copy to .env and fill in. Both values are public by design and are inlined into
# the binary at build time — never put SUPABASE_SERVICE_ROLE_KEY here or under any
# other prefix. This app has no service-role dependency.
#
# Local values come from `supabase status` in ../backbone.
#
# NOTE (device networking): a phone or emulator cannot reach the host's localhost.
#   - Android emulator: use http://10.0.2.2:54321
#   - physical device:  use http://<your-LAN-IP>:54321, on the same Wi-Fi
# `localhost` / 127.0.0.1 only works for the web target.

EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<paste from: supabase status in ../backbone>

# Deployed vendor web portal. Used for the links that stay on the web: register +
# KYC (D7-A), account deletion (D13-A), privacy policy (B6). Optional — when unset
# those links are hidden rather than shown broken.
EXPO_PUBLIC_VENDOR_PORTAL_URL=

# Display name — shown under the icon and in the store listing.
# Baked in at build time; restart the dev server after changing it.
EXPO_PUBLIC_APP_NAME=Ezzy Vendor
